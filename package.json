{
  "name": "wikitree",
  "productName": "WikiTree",
  "desktopName": "wikitree.desktop",
  "version": "2.1.0",
  "description": "Build trees of Wikipedia articles and read them in place — a desktop app for Linux, Windows and macOS.",
  "keywords": [
    "wikipedia",
    "mind-map",
    "knowledge-tree",
    "reader",
    "electron",
    "offline"
  ],
  "homepage": "https://github.com/boraned/wikitree#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boraned/wikitree.git"
  },
  "bugs": {
    "url": "https://github.com/boraned/wikitree/issues"
  },
  "author": "Boran Omeroglu <omerogluboran@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.mjs",
    "test:offline": "node tests/run.mjs --offline",
    "screenshots": "node scripts/screenshots.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:highlighter": "node scripts/build-highlighter.mjs",
    "build:docx": "node scripts/build-docx.mjs",
    "test:web": "npm run build:web && node tests/webapp.test.mjs",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac",
    "release": "bash scripts/release.sh",
    "install-desktop": "sh scripts/install-desktop.sh"
  },
  "build": {
    "appId": "io.github.boraned.wikitree",
    "productName": "WikiTree",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": "-"
    }
  },
  "devDependencies": {
    "docx-preview": "^0.4.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "playwright-core": "^1.64.1"
  }
}
